[include]
    path = ~/.gitconfig.local
[init]
	defaultBranch = main
[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    true-color = always
    navigate = true  # use n and N to move between diff sections
    dark = true      # or `light = true`, or omit for auto-detection
    hyperlinks = true
    syntax-theme = Monokai Extended
    line-numbers = true
    plus-style = syntax "#1f4d24"
    plus-emph-style = syntax "#2e7d32"
    minus-style = syntax "#5a1e1e"
    minus-emph-style = syntax "#8b2c2c"
    line-numbers-plus-style = "#4caf50"
    line-numbers-minus-style = "#e05252"
	file-style = bold yellow
	file-decoration-style = yellow box
	hunk-header-style = line-number syntax bold
	hunk-header-decoration-style = blue box

[merge]
    conflictStyle = zdiff3
